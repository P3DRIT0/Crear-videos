#!/bin/sh
# Comprueba solo el DDL en un servidor efímero. No conecta al PostgreSQL del usuario.
set -eu
cd "$(dirname "$0")/.."
image='postgres@sha256:c7526c0f6c3f30260a563d7bcf8ad778effac59a44f8ffa86678c35418338609'
endpoint=${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}
case "$endpoint" in
  unix://*) ;;
  *) echo 'La prueba requiere un daemon Docker local por socket Unix.' >&2; exit 1 ;;
esac
docker image inspect "$image" >/dev/null 2>&1 || {
  echo 'Falta la imagen local PostgreSQL 17.9. Puede ejecutar scripts/test con SQLite.' >&2
  exit 1
}
container=$(docker run --pull=never -d --rm --network none --tmpfs /var/lib/postgresql/data \
  -e POSTGRES_HOST_AUTH_METHOD=trust "$image" -c listen_addresses=)
trap 'docker stop -t 2 "$container" >/dev/null' EXIT
i=0
# Esperar al servidor definitivo (el entrypoint arranca otro durante initdb).
until docker exec "$container" sh -c 'test "$(cat /proc/1/comm)" = postgres && pg_isready -q'; do
  i=$((i+1))
  if [ "$i" -ge 30 ]; then echo 'PostgreSQL no arrancó a tiempo.' >&2; exit 1; fi
  sleep 1
done
psql_local() { docker exec -i "$container" psql -X -q -U postgres -d postgres -v ON_ERROR_STOP=1 --single-transaction -f -; }
psql_local < infra/migrations/001_core.up.sql
psql_local <<'SQL'
DO $$
BEGIN
  IF (SELECT count(*) FROM brands WHERE name='Retrobay') <> 1 THEN
    RAISE EXCEPTION 'falta Retrobay';
  END IF;
  INSERT INTO brands VALUES ('second','Exyo');
  INSERT INTO campaigns VALUES ('c','second','Nombre','Objetivo','2026-01-01T00:00:00Z');
  INSERT INTO jobs VALUES ('j','second','c','Ficha','pending',NULL,NULL,'2026-01-01T00:00:00Z');
  BEGIN
    UPDATE jobs SET brand_id='720c761b-64d9-4d3c-9dd5-b1dc2e82edeb' WHERE id='j';
    RAISE EXCEPTION 'se aceptó una campaña de otra marca';
  EXCEPTION WHEN foreign_key_violation THEN NULL;
  END;
  BEGIN
    UPDATE jobs SET state='succeeded' WHERE id='j';
    RAISE EXCEPTION 'se aceptó resultado sin hash';
  EXCEPTION WHEN check_violation THEN NULL;
  END;
  BEGIN
    DELETE FROM campaigns WHERE id='c';
    RAISE EXCEPTION 'se borró una campaña con jobs';
  EXCEPTION WHEN foreign_key_violation THEN NULL;
  END;
END $$;
SQL
psql_local < infra/migrations/002_production.up.sql
psql_local < infra/migrations/003_models.up.sql
psql_local < infra/migrations/004_policy.up.sql
psql_local < infra/migrations/004_policy.down.sql
psql_local < infra/migrations/003_models.down.sql
psql_local < infra/migrations/002_production.down.sql
psql_local < infra/migrations/001_core.down.sql
psql_local < infra/migrations/001_core.up.sql
psql_local < infra/migrations/002_production.up.sql
psql_local < infra/migrations/003_models.up.sql
psql_local < infra/migrations/004_policy.up.sql
docker exec "$container" postgres --version
echo 'OK · migración up/down/up, semilla, FK de marca, borrado y hash.'
